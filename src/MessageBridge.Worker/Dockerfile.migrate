# syntax=docker/dockerfile:1.7

ARG DOTNET_SDK_IMAGE_DIGEST=e1fc6e423f543119c406d24e2e687d67c569f18f04a37a8b0005d80ad0dcee80
ARG DOTNET_ASPNET_IMAGE_DIGEST=207cc51496778557731c81ff670333d8ade4a4fec22768fd1be8e78474a84ecf

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0@sha256:${DOTNET_SDK_IMAGE_DIGEST} AS build
ARG BUILDARCH
ARG TARGETARCH
WORKDIR /src

COPY . .
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && case "${BUILDARCH}" in \
        amd64) protoc_arch=x86_64 ;; \
        arm64) protoc_arch=aarch_64 ;; \
        *) echo "Unsupported BUILDARCH=$BUILDARCH" >&2 && exit 1 ;; \
        esac \
    && curl -fLsSo /tmp/protoc.zip "https://github.com/protocolbuffers/protobuf/releases/download/v28.0/protoc-28.0-linux-${protoc_arch}.zip" \
    && unzip -q /tmp/protoc.zip -d /tmp/protoc \
    && rm -rf /var/lib/apt/lists/* /tmp/protoc.zip \
    && chmod +x /tmp/protoc/bin/protoc
RUN rm -f global.json && DOTNET_NOLOGO=1 dotnet tool restore
RUN case "${TARGETARCH}" in \
    amd64) migration_runtime=linux-x64 ;; \
    arm64) migration_runtime=linux-arm64 ;; \
    *) echo "Unsupported TARGETARCH=$TARGETARCH" >&2 && exit 1 ;; \
    esac \
    && export PROTOC=/tmp/protoc/bin/protoc \
    && Database__Host=localhost \
    Database__Port=5432 \
    Database__Database=messagebridge_dev \
    Database__Username=dev \
    Database__Password=dev \
    Database__UseEntraAuth=false \
    Database__MaxPoolSize=12 \
    && \
    DOTNET_NOLOGO=1 dotnet restore src/MessageBridge.Infrastructure/MessageBridge.Infrastructure.csproj --runtime "$migration_runtime" \
    && \
    DOTNET_NOLOGO=1 dotnet build src/MessageBridge.Infrastructure/MessageBridge.Infrastructure.csproj --no-restore --configuration Release \
    && \
    design_time_output=src/MessageBridge.Infrastructure/bin/Release/net10.0 \
    && mkdir -p "$design_time_output/$migration_runtime" \
    && find "$design_time_output" -maxdepth 1 -type f -exec cp {} "$design_time_output/$migration_runtime"/ \; \
    && \
    DOTNET_NOLOGO=1 DOTNET_RUNTIME_ID="$migration_runtime" dotnet tool run dotnet-ef migrations bundle \
      --project src/MessageBridge.Infrastructure/MessageBridge.Infrastructure.csproj \
      --startup-project src/MessageBridge.Infrastructure/MessageBridge.Infrastructure.csproj \
      --context MessageBridgeDbContext \
      --self-contained \
      --runtime "$migration_runtime" \
      --no-build \
      --configuration Release \
      --output /out/migrate \
      --force


FROM --platform=$TARGETPLATFORM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:${DOTNET_ASPNET_IMAGE_DIGEST} AS runtime
WORKDIR /app

COPY --from=build /out/migrate /app/migrate
RUN chmod +x /app/migrate
USER 1000
ENTRYPOINT ["/app/migrate"]
