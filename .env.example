# Local development environment variables
# Copy to .env.local or load via docker-compose for local testing

# RabbitMQ (local Docker Compose)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# PostgreSQL / Worker database contract (local password mode)
Database__Host=localhost
Database__Port=5432
Database__Database=messagebridge_dev
Database__Username=dev
Database__Password=dev
Database__UseEntraAuth=false
Database__MaxPoolSize=12

# Worker configuration
WORKER_LOG_LEVEL=Information
